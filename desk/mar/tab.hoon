=,  format
=,  mimes:html
|_  tab=wain
::
++  grab                                                ::  convert from
  |%
  ++  mime  |=((pair mite octs) (to-wain q.q))
  ++  noun  wain                                        ::  clam from %noun
  ++  txt   wain
  --
++  grow
  |%
  ++  mime  [/text/tab-separated-values (as-octs (of-wain tab))]
  --
++  grad  %mime
--
